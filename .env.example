# Copy to .env (setup_soc.py does this for you) - every line is optional except ANALYST_PASSWORD.
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=change-me
SECRET_KEY=generate-a-long-random-string
INGEST_API_KEY=key-your-SIEM-sends-in-the-X-API-Key-header

# Reasoning model: openrouter | ollama | groq | openai_compat | none | auto
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Groq retired its Llama 3 models in Aug 2026; its default here is an open-weight gpt-oss model
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# RAG: auto = Milvus Lite file (Linux/macOS) or built-in store (Windows); MILVUS_URI=http://host:19530 for a server
VECTOR_STORE=auto
MILVUS_URI=
EMBEDDING_BACKEND=hash

# Response integrations - nothing runs until an analyst approves
FIREWALL_PROVIDER=mock
IDENTITY_PROVIDER=mock
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_WAF_SCOPE=REGIONAL
AWS_WAF_IPSET_NAME=
AWS_WAF_IPSET_ID=
OKTA_ORG_URL=
OKTA_API_TOKEN=
FIREWALL_BLOCK_CMD=
FIREWALL_UNBLOCK_CMD=
IP_ALLOWLIST=
AUTO_APPROVE=false
